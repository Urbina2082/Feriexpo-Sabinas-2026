---
const { im, nombre, fecha, genero } = Astro.props;
---

<div
  style={`background-image:linear-gradient(to top, #000000, #00000000),url('${im}');`}
  class="card"
>
  <div class="info">
    <h4>{nombre}</h4>
    <p>
      <svg
        class="date"
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-calendar text-secondary"
        ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
          width="18"
          height="18"
          x="3"
          y="4"
          rx="2"></rect><path d="M3 10h18"></path></svg
      >
      {fecha}
    </p>
    <p class="genre">
      <svg
        class="gen"
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-music text-primary"
        ><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"
        ></circle><circle cx="18" cy="16" r="3"></circle></svg
      >
      {genero}
    </p>

    <div class="buts">
      <!-- <button class="buto">Ver Detalles</button> -->
      <button>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-ticket"
          ><path
            d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"
          ></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path
            d="M13 11v2"></path></svg
        > Ver Detalles</button
      >
    </div>
  </div>
</div>

<style>
  .card {
    display: inline-block;
    box-shadow: 0px 00px 20px 5px #00000010;
    border-radius: 25px;
    border: 1px solid #0000004d;
    overflow: hidden;
    margin: 0rem 1rem;
    width: 100%;
    max-width: 20rem;
    height: 34rem;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    position: relative;
    object-position: top center;
   
  }

  h4 {
    margin: 0px;
    font-size: clamp(1.7rem, 2vw, 4rem);
    font-weight: 900;
    
  }

  .info {
    padding: 1rem 1rem;
    color: #ffffffdb;
    position: absolute;
    width: 100%;
    bottom: 0px;
    box-sizing:border-box;
  }

  .buts {
    display: flex;
    gap: 1rem;
  }

  button {
    border-radius: 25px;
    border: 1px solid #d9b00e00;
    padding: 0.6rem 2rem;
    margin:.5rem 0rem ;
    background: var(--green-700);
    backdrop-filter: blur(0px);
    color: #ffffff;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .buto {
    /* background: #ffffff47;
    border: 1px solid #d7b20c61; */
    color: #ffffff;
    font-weight: 400;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .date {
    color: #0eaa57f6;
  }
  .gen {
    color: #ffb805;
  }
  .genre {
    font-size: 0.9rem;
    color: #ffffffa1;
  }
  @media (max-width: 768px) {
    .card {
      max-width: 20rem;
      height: 32rem;
    }
  }
</style>
