---
const { sv, num, p } = Astro.props;
---

<div class="report">
  <div set:html={sv} class="im" />
  <div class="num">{num}</div>
  <p>{p}</p>
</div>

<style>
  .report {
    display: inline-flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 2rem;
    border-radius: 25px;
    background: #ffffff06;
    backdrop-filter: blur(50px);
    color: rgba(255, 255, 255, 0.646);
    border: 1px solid #ffffff1a;
    font-weight: 500;
    min-width: 120px;
    max-width: 300px;
  }

  .num {
    display: inline-block;
    font-size: clamp(1.9rem, 2.5vw, 3rem);
    font-weight: 700;
    margin: 0.5rem 0rem;
    color: #fffef8;
    /* background-image: var(--gradient-title);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent; */
  }

  .im {
    display: inline-block;
    color: var(--green-700);
  }

  p {
    display: inline-block;
  }
  @media (max-width: 768px) {
    .report {
      font-weight: 400;

      padding: 1rem;
    }
    .num {
      font-weight: 600;
    }
  }
</style>
