---
const { im, nombre, fecha, hora, des } = Astro.props;
---

<div class="card">
  <div class="sv">
    <img src={im} alt={nombre} />
  </div>
  <div class="info">
    <h4>{nombre}</h4>
    <div class="fech">
      <p>
        <svg
          class="calendar"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-calendar text-secondary"
          ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
            width="18"
            height="18"
            x="3"
            y="4"
            rx="2"></rect><path d="M3 10h18"></path></svg
        >
        {fecha}
      </p>
      <p>
        <svg
          class="clock"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-clock text-primary"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        {hora}
      </p>
    </div>
    <p>{des}</p>

    <button>GRATUITO</button>
  </div>

  <style>
    .card {
      display: inline-block;
      border-radius: 25px;
      border: 1px solid #ffffff52;
      padding: 2rem 1.5rem;

      background: #ffffff0c;
      backdrop-filter: blur(50px);
      max-width: 27rem;
    }

    .card img {
      width: 120px;
      border-radius: 0px;
    }
    h4 {
      /* color: rgba(212, 168, 9, 0.817); */
      margin: 0px;
      font-size: clamp(1.6rem, 2vw, 4rem);
    }
    .sv {
      display: inline-block;
      color: #ffffff;

      padding: 1rem 0rem 0rem›;

      border-radius: 12px;
    }
    .info {
      padding: 1rem 0rem 0rem;
      color: #ffffffdb;
    }

    .fech {
      margin: 0.5rem 0rem;
      font-size: 0.9rem;
      font-weight: 400;
      color: #ffffff9f;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .calendar {
      color: var(--green-700);
    }
    .clock {
      color: var(--green-700);
    }

    .fech p {
      margin: 0px;

      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    button {
      border-radius: 25px;
      border: 1px solid #fffefa5a;
      padding: 0.7rem 2rem;
      background: var(--gold-700transparent);
      backdrop-filter: blur(20px);
      color: #ffffff;
      font-size: 0.9rem;
    }
  </style>
</div>
