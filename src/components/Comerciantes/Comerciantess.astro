---
const { im, nombre, op1, op2, op3, des, price, subprice } = Astro.props;
---

<div class="cardd">
  <div class="sv">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="34"
      height="34"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-store text-secondary"
      ><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"
      ></path><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><path
        d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path><path d="M2 7h20"
      ></path><path
        d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"
      ></path></svg
    >
  </div>
  <div class="info">
    <h4>{nombre}</h4>
    <p>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-ruler"
        ><path
          d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"
        ></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"
        ></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"
        ></path></svg
      >
      {des}
    </p>
    <ul>
      <li>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-circle-check text-primary flex-shrink-0"
          ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
          ></path></svg
        >
        {op1}
      </li>
      <li>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-circle-check text-primary flex-shrink-0"
          ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
          ></path></svg
        >
        {op2}
      </li>
      <li>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-circle-check text-primary flex-shrink-0"
          ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
          ></path></svg
        >
        {op3}
      </li>
    </ul>
    <hr />
    <span>{price} <small>{subprice}</small></span>
  </div>

  <style>
    .cardd {
      display: block;
      border-radius: 25px;
      border: 1px solid #ffffff52;
      padding: 3rem 1.6rem;
      margin: 0rem 1rem;
      background: #0000005b;
      backdrop-filter: blur(50px);
      overflow: hidden;
      min-width: 17rem;
      max-width: 18rem;
      width: 100%;
    }

    h4 {
      margin: 0px;
      font-size: clamp(1.6rem, 2vw, 4rem);
      color: #ffffffee;
    }
    .sv {
      display: inline-block;
      color: #ffffff;

      padding: 1rem;
      background: #e39e0962;
      border-radius: 12px;
    }
    .info {
      padding: 1rem 0rem 0rem;
      color: #ffffff84;
    }

    p {
      margin: 10px 0px;
    }
    ul {
      margin: 0px;
      padding: 0px;
      list-style: none;
      margin: 1rem 0rem;
    }

    ul li {
      margin: 10px 0px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    hr {
      border: 0.5px solid #ffffff22;
      border-radius: 25px;
      margin: 2rem 0rem;
    }
    span {
      font-size: 1.9rem;
      margin: 1rem 0rem;
      color: #ffffff;
      font-weight: 600;
    }
    small {
      font-size: 0.9rem;
      color: #ffffff80;
    }

    @media (max-width: 768px) {
      .card {
        width: 100%;
      }
    }
  </style>
</div>
