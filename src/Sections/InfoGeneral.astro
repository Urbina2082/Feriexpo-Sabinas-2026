---
import InitSection from "../components/InitSection.astro";
import General from "../components/General/General.astro";

const general = [
  {
    sv: ` <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>`,
    tit: "Fechas",
    pr: "Del 11 al 22 de septiembre,2026",
  },
  {
    sv: ` <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    tit: "Horario",
    pr: "5:00 PM a 2:00 AM",
  },
  {
    sv: ` <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
    tit: "Ubicacion",
    pr: "Recinto Ferial Sabinas Coahuila",
  },
  {
    sv: ` <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-baby w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"><path d="M9 12h.01"></path><path d="M15 12h.01"></path><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"></path><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"></path></svg>`,
    tit: "Niños",
    pr: "Menores de 3 años entran gratis",
  },
   {
    sv: ` <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-car w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg> `,
    tit: "Estacionamiento",
    pr: "Disponible con costo adicional",
  },
];
---

<div class="gene">
  <InitSection
    sub=""
    title="Informacion"
    sp="General"
    pr="Todo lo que nesesitas saber para disfrutar al maximo la Feriexpo Sabinas 2026."
  />

  <div class="cards">
    {general.map((gen) => <General sv={gen.sv} tit={gen.tit} pr={gen.pr} />)}
  </div>
</div>

<style>
  .gene{
    margin: 6rem 0rem;
    padding: 0rem .5rem;
  }

  .cards {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {

      .cards {
    
    gap: 1rem;}
  }
</style>
