---
import Card from "../components/Cabalgata/Card.astro";

const general = [
  {
    sv: `🐂`,
    tit: "Concurso del Becerro Gordo",
    pr: "Exhibición tradicional donde los mejores ejemplares compiten por obtener el reconocimiento al becerro con mejor desarrollo, siendo uno de los eventos ganaderos más esperados de la feria.",
    fech: "Domingo 13 de septiembre",
  },
  {
    sv: `🐑`,
    tit: "Concurso del Borrego Gordo",
    pr: "Competencia dedicada a reconocer la calidad y el excelente manejo del ganado ovino por parte de los productores de la región.",
    fech: "Sábado 19 de septiembre",
  },
  {
    sv: `🐎`,
    tit: "Concurso de Caballo ¼ de Milla",
    pr: "Los mejores ejemplares de la raza Cuarto de Milla demostrarán su belleza, conformación y cualidades en una competencia llena de tradición ecuestre.",
    fech: "",
  },
];
---

<div class="Cabalgata">
  <img src="/iconTransp.avif" alt="Cabalgata" />

  <div class="cards">
    {
      general.map((gen) => (
        <Card sv={gen.sv} fech={gen.fech} tit={gen.tit} pr={gen.pr} />
      ))
    }
  </div>

  <div class="after">
    <span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-star fill-secondary"
        ><path
          d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
        ></path></svg
      >SAVE DATE</span
    >

    <h3>AFTER CABALGATA</h3>
    <p class="date">12 de septiembre • 4:00 PM</p>
    <p class="desc">
      Después de la tradicional Gran Cabalgata continúa la celebración con
      música, convivencia y un ambiente totalmente familiar. Un evento pensado
      para que cabalgantes y visitantes disfruten del cierre perfecto de una de
      las tradiciones más importantes de Sabinas. La Gran Cabalgata se realiza
      el 12 de septiembre como parte de las festividades de Feriexpo Sabinas.
    </p>
    <div class="select">🐎 🤠 🐂 🐑 🎵</div>
  </div>
</div>
<style>
  .Cabalgata {
    text-align: center;
  }
  img {
    width: 250px;
    margin: 3rem 0rem ;
  }
  .cards {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
  span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 25px;
    border: var(--gold-700) solid 1px;
    background: var(--gold-700-transparent);
    gap: 0.5rem;
    font-size: 1rem;
    padding: 0.5rem 1rem;
    font-weight: 500;
    color: var(--gold-700);
    margin: 1rem 0rem;
  }
  h3 {
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 900;
    margin: 0.5rem 0rem;
    /* background: var(--gradient-title);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; */
  }
  .date {
    font-size: 1rem;
    font-weight: 400;
    color: var(--gold-700);
  }
  .desc {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5rem;
    color: rgba(255, 255, 255, 0.717);
    margin: 0.5rem 0rem;
  }

  .fill-secondary {
    fill: var(--gold-700);
  }

  .after {
    margin: 4rem 1rem;
    display: inline-block;
    padding: 2rem 1rem;
    border-radius: 25px;
    background: var(--fondo-after);
    box-shadow: 0px 0px 40px 10px var(--gold-700-transparent);
    max-width: 40rem;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    backdrop-filter: blur(50px);
    color: rgba(255, 255, 255, 0.875);
    border: 1px solid var(--gold-700-transparent);
  }
</style>
