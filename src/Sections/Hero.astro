---
import { Image } from "astro:assets";
import Icon from "../assets/iconTransp.avif";
import Timer from "../components/Timer.astro";
---

<div class="hero">
  <div class="menu">
    <!-- <h2>Feriexpo Sabinas 2026</h2> -->
  </div>
  <div class="content">
    <Image class="imh" src={Icon} alt="Icono" />
    <!-- <h1>FeriExpo <span>Sabinas 2026</span></h1> -->
    <p>
      La fiesta más grande del norte de Mexico te espera. Diversión, música y
      tradición en un solo lugar.
    </p>
    <div class="buts">
      <a href="#Cartelera">
        <button>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-calendar"
            ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
              width="18"
              height="18"
              x="3"
              y="4"
              rx="2"></rect><path d="M3 10h18"></path></svg
          >Ver Cartelera</button
        ></a
      >
    </div>

    <Timer />
  </div>
</div>

<style>
  .hero {
    width: 100%;
    height: 100vh;
    background-image:
      linear-gradient(to top, #000000c0, #0000009f), url(/her-bg.avif);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    text-align: center;
  }
  /* .menu {
    background: #ffffff08;

    white-space: nowrap;
    position: fixed;
    left: 50%;
    transform: translateX(-50%);

    z-index: 9999;
    margin: 2.5rem 0rem;
    padding: 0.5rem 4rem;
    backdrop-filter: blur(7px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 25px;
  } */
  .content {
    padding: 2rem 01rem 0rem;
  }
  .imh {
    width: 380px;
    border-radius: 25px;
    height: auto;
    margin: 3rem 0rem 0rem;
     /* padding: 1.3rem 1.5rem;
    backdrop-filter: blur(7px);
    border: 1px solid rgba(255, 255, 255, 0.1); */
  }
  h2 {
    font-size: clamp(1.2rem, 1.5vw, 1.9rem);
    margin: 0px 0px;
    color: var(--green-600);
    /* background-image: var(--gradient-title);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent; */
  }
  h1 {
    font-size: clamp(2.9rem, 4.5vw, 5rem);
    color: #fff;
    margin: 0px;
  }
  span {
    color: var(--green-700) ;
    /* background-image: var(--gradient-title);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent; */
    font-weight: 700;
  }
  p {
    color: #ffffffde;
    font-size: clamp(1.2rem, 1.2vw, 4rem);
  }

  a {
    text-decoration: none;
  }
  button {
    font-size: 1rem;
    padding: .8rem 3rem;
    border-radius: 25px;
    color: #fff;
    background: #ffffff22;
    border: 1px solid #ffffff4c;
    backdrop-filter: blur(4px);
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 3rem auto 0rem;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .imh {
      width: 220px;
    }

    .hero{
          background-image:
      linear-gradient(to top, #000000c0, #0000009f), url(/hero-tel.avif);
    }
  }
</style>
