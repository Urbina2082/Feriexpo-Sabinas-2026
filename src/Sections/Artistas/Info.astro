---
const { artista } = Astro.props;
---

<div class="informacion">
  <div class="sobre">
    <h3>Sobre el Artista</h3>
    <p>
      {artista.info}
    </p>
  </div>

  <div class="jun-inf">
    <div class="pres">
      <h4>PRESENTACION</h4>
      <div class="pre-inf">
        <p>
          <svg
            class="date"
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-astro-cid-eesvpkgy=""
            ><path d="M8 2v4" data-astro-cid-eesvpkgy=""></path><path
              d="M16 2v4"
              data-astro-cid-eesvpkgy=""></path><rect
              width="18"
              height="18"
              x="3"
              y="4"
              rx="2"
              data-astro-cid-eesvpkgy=""></rect><path
              d="M3 10h18"
              data-astro-cid-eesvpkgy=""></path></svg
          >
          {artista.fecha}
        </p>
        <p>
          <svg
            class="clock"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-astro-cid-mxxh4sk3=""
            ><circle cx="12" cy="12" r="10" data-astro-cid-mxxh4sk3=""
            ></circle><polyline
              points="12 6 12 12 16 14"
              data-astro-cid-mxxh4sk3=""></polyline></svg
          >
          {artista.hora}
        </p>
        <p>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-map-pin w-8 h-8 text-secondary mb-3 group-hover:scale-110 transition-transform"
            ><path
              d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          {artista.lugar}
        </p>
      </div>
    </div>

    <div class="redes">
      <h4>REDES SOCIALES</h4>
      <div class="red">
        <a href=""
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
            ></path>
          </svg></a
        >
        <a href=""
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-youtube"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8"
            ></path>
            <path d="M10 9l5 3l-5 3l0 -6"></path>
          </svg></a
        >
        <a href=""
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-spotify"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
            <path d="M8 11.973c2.5 -1.473 5.5 -.973 7.5 .527"></path>
            <path d="M9 15c1.5 -1 4 -1 5 .5"></path>
            <path d="M7 9c2 -1 6 -2 10 .5"></path>
          </svg></a
        >
      </div>
    </div>
  </div>
</div>

<style>
  .informacion {
    padding: 0rem 4rem;
    margin: 3rem 0rem;
  }
  .pres,
  .redes {
    background: #ffffff06;
    backdrop-filter: blur(50px);
    display: inline-block;
    border: 1px solid #ffffff1a;
    padding: 1.5rem 1.5rem;
    border-radius: 25px;
  }
  h4,
  h3 {
    background: var(--gradient-title);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 400;
    margin: 0rem;
    font-size: 1rem;
  }

  h3 {
    font-size: 3rem;
    font-weight: 600;
    color: var(--green-700);
  }
  .pre-inf {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0px 0px 0px;
    color: #fff;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 20px 0px 10px;
    color: #fff;
  }

  .sobre {
    max-width: 50rem;
  }
  .sobre p {
    line-height: 1.6rem;
    font-weight: 400;
    color: #ffffffcb;
  }

  .red {
    display: inline-flex;
    margin: 10px 0px;
    align-items: center;
    gap: 1rem;
  }

  a {
    background: #ffffff06;
    backdrop-filter: blur(50px);
    display: inline-flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #ffffff1a;
    padding: 0.8rem;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
  }
  .jun-inf {
    margin: 2rem 0rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .informacion {
      padding: 0rem 1rem;
      margin: 4rem 0rem;
    }
    .pre-inf {
      display: flex;
      gap: 0rem;
      min-width: 17rem;
      flex-direction: column;
      margin: 0px 0px 0px;
      color: #fff;
    }
  }
</style>
