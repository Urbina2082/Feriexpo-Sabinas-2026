</div>

<script>
  const boton = document.querySelector("#whatsapp");

  boton?.addEventListener("click", () => {
    const url = encodeURIComponent(window.location.href);
    const texto = encodeURIComponent("Mira este artista:");

    window.open(`https://wa.me/?text=${texto}%20${url}`, "_blank");
  });a
</script>

<style>
  .banner {
    width: 100%;
    height: 90vh;
    background-image:
      linear-gradient(to top, #000000, #00000000), var(--imagen-desktop);
    background-position: center;
    background-size: cover;
    position: relative;
  }

  .info {
    padding-left: 4rem;
    color: rgb(255, 255, 255);
    position: absolute;
    bottom: 2rem;
  }
  span {
    background: #ee850c;
    color: #000000;
    font-weight: 500;
    padding: 0.5rem 1.5rem;
    border-radius: 25px;
    font-size: 0.8rem;
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
  }

  h2 {
    font-size: clamp(2.5rem, 4vw, 6rem);
    margin: 15px 0px;
    font-weight: 900;
  }

  .pre-inf {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0px 0px 15px;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .buts {
    display: flex;

    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  button {
    background: #ee850c;
    color: rgb(0, 0, 0);
    border: none;
    padding: 0.7rem 1.5rem;
    border-radius: 25px;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 500;
  }

  a {
    text-decoration: none;
  }
  .comp {
    background: rgba(0, 0, 0, 0.11);
    color: rgb(254, 254, 255);
    border: solid 1px #ffffff17;
  }

  @media (max-width: 768px) {
    .banner {
      background-image:
        linear-gradient(to top, #000000, #00000000), var(--imagen-mobile);
    }

    h2 {
      margin: 15px 0px;
      font-weight: 900;
    }

    .pre-inf {
      display: flex;

      gap: 0.5rem;
      margin: 0px 0px 15px;
    }
    p {
      margin: 5px 0px;
      gap: 0.3rem;
    }

    .info {
      padding: 0rem 1.5rem;
    }
  }
</style>
