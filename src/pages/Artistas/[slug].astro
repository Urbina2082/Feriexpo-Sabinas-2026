---
import type { GetStaticPaths } from "astro";
import { artistas } from "../../Data/Artistas";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../Sections/Artistas/Hero.astro";
import Info from "../../Sections/Artistas/Info.astro";
import Demo from "../../Sections/Artistas/Demo.astro";
import Footer from "../../Sections/Footer.astro";
import SemiFott from "../../Sections/SemiFott.astro";

export function getStaticPaths() {
  return artistas.map((artista) => ({
    params: {
      slug: artista.slug,
    },
    props: {
      artista,
    },
  }));
}

const { artista } = Astro.props;
---

<Layout
  title={artista.nombre}
  description={`${artista.fecha} · ${artista.genero}`}
  image={artista.im}
>
  <Hero artista={artista} loading="lazy" />
  <Info artista={artista} loading="lazy" />
  <Demo artista={artista} loading="lazy" />
  <SemiFott loading="lazy"/>
  <Footer loading="lazy" />
</Layout>
